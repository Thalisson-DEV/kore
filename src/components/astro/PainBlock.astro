---
import PainStats from '../react/PainStats';

const pains = [
  {
    text: "Mandei 50 currículos. Recebi 3 respostas. Me encaixava em todas as vagas.",
    role: "back-end",
    years: "4 anos",
    highlight: true,
  },
  {
    text: "Reescrevo o CV do zero pra cada vaga. Nunca sei se ficou bom.",
    role: "fullstack",
    years: "2 anos",
    highlight: false,
  },
  {
    text: "Vejo devs mais juniores sendo chamados pra entrevista. Pra vagas que negaram pra mim.",
    role: "front-end",
    years: "6 anos",
    highlight: false,
  },
  {
    text: "O recrutador 'não viu' a minha experiência. Que tá lá. Em letras garrafais.",
    role: "data eng",
    years: "3 anos",
    highlight: false,
  },
  {
    text: "Já copiei keyword de tutorial no YouTube. Não mudou um milímetro.",
    role: "qa",
    years: "5 anos",
    highlight: false,
  },
  {
    text: "Sei que estou fazendo algo errado. Ninguém me explica o quê.",
    role: "devops",
    years: "júnior",
    highlight: true,
  },
];
---

<section class="relative py-28 lg:py-40 reveal overflow-hidden">

  <!-- Hachura -->
  <div
    class="absolute inset-0 pointer-events-none opacity-50 hatch-bg"
  ></div>

  <div class="container-kore relative z-10">

    <!-- Eyebrow + Headline -->
    <div class="mb-16 lg:mb-20 max-w-3xl">
      <p class="divider-label mb-6">
        <span class="w-8 h-px bg-faint"></span>
        <span>dor_do_candidato</span>
      </p>

      <h2 class="text-section mb-6 text-balance">
        Não é falta de skill<span class="text-accent">.</span><br/>
        É falta de <span class="pain-underline">tradução</span>.
      </h2>

      <p class="text-lg text-muted leading-relaxed max-w-2xl">
        88% dos currículos são descartados por um software ATS <span class="text-text font-medium">antes de qualquer humano abrir</span>.
        Você não está competindo com o dev do lado — está competindo com a máquina que decide se ele te vê.
      </p>
    </div>

    <!-- Wall of pain -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mb-20">
      {pains.map((pain, i) => (
        <article
          class:list={[
            "pain-card group relative bg-surface/40 border border-dashed border-border p-6 hover:border-accent/40 hover:border-solid transition-all duration-300",
            pain.highlight && "lg:col-span-2 lg:row-span-1 bg-surface/60",
          ]}
          style={`--pain-delay: ${i * 0.08}s`}
        >
          <!-- Quote mark -->
          <span class="absolute top-4 left-5 text-accent/20 text-3xl font-display leading-none select-none group-hover:text-accent/40 transition-colors duration-300">
            "
          </span>

          <!-- Texto da dor -->
          <p
            class:list={[
              "relative pl-5 text-text leading-relaxed group-hover:text-text transition-colors mb-5",
              pain.highlight ? "text-base lg:text-lg font-medium" : "text-sm",
            ]}
          >
            {pain.text}
          </p>

          <!-- Atribuição -->
          <div class="flex items-center gap-2 pl-5 pt-4 border-t border-border-subtle">
            <span class="w-1 h-1 rounded-full bg-faint"></span>
            <span class="text-[10px] font-mono text-faint uppercase tracking-widest">
              {pain.role} · {pain.years}
            </span>
          </div>

          <!-- Bottom accent line -->
          <div class="absolute bottom-0 left-0 w-0 h-px bg-accent transition-all duration-500 group-hover:w-full"></div>
        </article>
      ))}
    </div>

    <!-- Stats row -->
    <PainStats client:visible />

    <!-- Bridge statement -->
    <div class="mt-20 lg:mt-24 max-w-3xl">
      <div class="flex items-start gap-6">
        <div class="hidden lg:flex flex-col items-center pt-2">
          <div class="w-px h-12 bg-gradient-to-b from-transparent to-accent"></div>
          <div class="w-2 h-2 rounded-full bg-accent shadow-[0_0_12px_rgba(59,130,246,0.6)]"></div>
        </div>
        <div class="flex-1">
          <p class="text-xl md:text-2xl font-bold text-text leading-snug mb-4 text-balance">
            Não é falta de competência. <span class="text-muted font-medium">É que ninguém te ensinou a falar a língua da máquina.</span>
          </p>
          <p class="text-sm text-faint leading-relaxed max-w-xl">
            A KORE_ traduz seu CV para o ATS com injeção semântica de keywords da vaga real.
            <span class="text-muted">Sem mentir. Sem inventar experiência.</span>
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Stagger reveal nos cards de dor */
  .pain-card {
    opacity: 0;
    transform: translateY(16px);
    animation: pain-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--pain-delay, 0s) forwards;
  }

  .reveal:not(.active) .pain-card {
    animation: none;
  }

  @keyframes pain-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Trigger pain-card animations when reveal section becomes active
  const section = document.querySelector('section.reveal');
  if (section) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
          }
        });
      },
      { threshold: 0.05 }
    );
    document.querySelectorAll('.pain-card').forEach((c) => observer.observe(c));
  }
</script>
