---
---

<section id="precos" class="relative section-gap bg-bg reveal">
  <div class="container-kore">
    <!-- Separador -->
    <div class="divider-label mb-24">
      <span class="w-12 border-t border-dashed border-border"></span>
      PREÇOS
      <span class="flex-grow border-t border-dashed border-border"></span>
    </div>

    <h2 class="text-section mb-20">Planos Disponíveis<span class="text-accent">.</span></h2>

    <div class="grid lg:grid-cols-3 gap-8 items-stretch">
      <!-- Gratuito -->
      <div class="relative flex flex-col p-10 border border-dashed border-border bg-surface/20 rounded-sm">
        <span class="cross-marker corner-tl"></span>
        <span class="cross-marker corner-tr"></span>
        <span class="cross-marker corner-bl"></span>
        <span class="cross-marker corner-br"></span>
        <div class="flex justify-between items-start mb-10">
          <div>
            <h3 class="text-card uppercase font-bold tracking-tighter">Gratuito</h3>
            <p class="text-[10px] font-mono text-muted mt-1 tracking-widest uppercase">BYOK</p>
          </div>
          <span class="px-2 py-1 border border-dashed border-border text-[9px] font-mono text-muted uppercase tracking-tighter">EM DESENVOLVIMENTO</span>
        </div>
        
        <div class="mb-12">
          <span class="text-5xl font-bold tracking-tighter">R$ 0</span>
          <span class="text-caption text-faint ml-2">/sempre</span>
        </div>

        <ul class="space-y-5 mb-auto text-caption text-muted">
          <li class="flex items-center gap-3"><span class="text-faint">/</span> Motor ATS Ilimitado</li>
          <li class="flex items-center gap-3"><span class="text-faint">/</span> 1 Persona Ativa</li>
          <li class="flex items-center gap-3"><span class="text-faint">/</span> Local Encryption</li>
        </ul>

        <button disabled class="mt-12 w-full py-4 border border-dashed border-border text-faint text-[11px] font-bold rounded-sm cursor-not-allowed uppercase tracking-widest">Indisponível</button>
      </div>

      <!-- Pro -->
      <div class="flex flex-col p-10 border-2 border-accent bg-surface/40 rounded-sm relative shadow-[0_0_40px_rgba(59,130,246,0.05)]">
        <div class="flex justify-between items-start mb-10">
          <div>
            <h3 class="text-card uppercase font-bold tracking-tighter">Kore Pro</h3>
            <p class="text-[10px] font-mono text-accent mt-1 tracking-widest uppercase">Mais Poder</p>
          </div>
          <span class="px-2 py-1 bg-accent text-bg text-[9px] font-mono font-bold uppercase tracking-tighter">RECOMENDADO</span>
        </div>
        
        <div class="mb-12">
          <span class="text-5xl font-bold tracking-tighter">R$ 29</span>
          <span class="text-caption text-accent/60 ml-2">/mês</span>
        </div>

        <ul class="space-y-5 mb-auto text-caption text-text">
          <li class="flex items-center gap-3 text-accent"><span class="font-bold">●</span> Motor IA Incluso (GPT-4o)</li>
          <li class="flex items-center gap-3 text-accent"><span class="font-bold">●</span> 5 Personas Ativas</li>
          <li class="flex items-center gap-3 text-accent"><span class="font-bold">●</span> PDF Export Premium</li>
        </ul>

        <a href="#acesso" class="mt-12 w-full py-4 bg-accent hover:bg-accent-dim text-bg text-[11px] font-bold rounded-sm text-center transition-all uppercase tracking-widest shadow-[0_0_20px_rgba(59,130,246,0.2)]">Garantir Acesso</a>
      </div>

      <!-- Premium -->
      <div class="relative flex flex-col p-8 border border-dashed border-border bg-surface/20 rounded-sm opacity-80">
        <span class="cross-marker corner-tl"></span>
        <span class="cross-marker corner-tr"></span>
        <span class="cross-marker corner-bl"></span>
        <span class="cross-marker corner-br"></span>
        <div class="flex justify-between items-start mb-8">
          <div>
            <h3 class="text-card uppercase font-bold tracking-tighter">Kore Agent</h3>
            <p class="text-[10px] font-mono text-muted mt-1 tracking-widest uppercase">Autônomo</p>
          </div>
          <span class="px-2 py-0.5 border border-dashed border-border text-[9px] font-mono text-muted uppercase">EM DESENVOLVIMENTO</span>
        </div>
        
        <div class="mb-12">
          <span class="text-4xl font-bold tracking-tighter">R$ 119</span>
          <span class="text-caption text-faint ml-2">/mês</span>
        </div>

        <ul class="space-y-4 mb-auto text-caption text-muted">
          <li class="flex items-center gap-2"><span>-</span> Agente de Candidatura</li>
          <li class="flex items-center gap-2"><span>-</span> Personas Ilimitadas</li>
          <li class="flex items-center gap-2"><span>-</span> Suporte 1:1</li>
        </ul>

        <button disabled class="mt-12 w-full py-3 border border-dashed border-border text-faint text-caption font-bold rounded-sm cursor-not-allowed uppercase">Indisponível</button>
      </div>
    </div>
  </div>
</section>
