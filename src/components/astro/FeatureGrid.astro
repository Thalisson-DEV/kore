---
// FeatureGrid.astro
const features = [
  {
    title: "Precisão Algorítmica",
    value: "98",
    suffix: "%",
    subtitle: "Match semântico de perfil e validação precisa de senioridade real.",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`
  },
  {
    title: "Soberania Digital",
    value: "100",
    suffix: "%",
    subtitle: "Seus dados, seu cofre. Modelo BYOK local-first com controle total.",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`
  },
  {
    title: "Criptografia de Elite",
    value: "256",
    suffix: "-BIT",
    subtitle: "Criptografia AES-256-GCM em cada byte processado localmente.",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/></svg>`
  },
  {
    title: "Injeção Vetorial",
    value: "Engine",
    suffix: "",
    subtitle: "Supera filtros simples com contexto técnico e vetores semânticos.",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  }
];
---

<section class="relative py-20 border-y border-border-subtle bg-surface/20 reveal">
  <!-- Decorative background line -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-12 bg-gradient-to-b from-accent/50 to-transparent"></div>

  <div class="container-kore">
    <div class="divider-label mb-16 justify-center">
      <span class="w-12 h-[1px] bg-border"></span>
      INFRAESTRUTURA_STATS
      <span class="w-12 h-[1px] bg-border"></span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-border border border-border rounded-sm overflow-hidden">
      {features.map((feat) => (
        <div class="group relative bg-bg p-10 transition-all duration-500 hover:bg-surface/50">
          <!-- Hover Glow Effect -->
          <div class="absolute inset-0 bg-accent/0 group-hover:bg-accent/[0.02] transition-colors duration-500"></div>
          
          <div class="relative z-10 space-y-6">
            <div class="w-10 h-10 rounded bg-accent/5 border border-accent/20 flex items-center justify-center text-accent group-hover:border-accent/50 group-hover:scale-110 transition-all duration-500 shadow-[0_0_15px_rgba(59,130,246,0.1)]">
              <Fragment set:html={feat.icon} />
            </div>

            <div>
              <div class="flex items-baseline gap-1 mb-2">
                <span 
                  class="text-3xl font-bold tracking-tighter text-text group-hover:text-accent transition-colors duration-500"
                  data-counter={feat.value.match(/\d+/) ? feat.value : null}
                  data-suffix={feat.suffix}
                >
                  {feat.value}{feat.suffix}
                </span>
              </div>
              <h3 class="text-[11px] font-mono font-bold text-accent/80 uppercase tracking-[0.2em] mb-4">{feat.title}</h3>
              <p class="text-sm text-muted leading-relaxed font-medium">{feat.subtitle}</p>
            </div>
          </div>

          <!-- Bottom Border Active State -->
          <div class="absolute bottom-0 left-0 w-0 h-[2px] bg-accent group-hover:w-full transition-all duration-700 ease-in-out"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  // 2.2 Animated Counter with Intersectional Observer
  document.querySelectorAll('[data-counter]').forEach(el => {
    const target = +el.dataset.counter;
    if (isNaN(target)) return;

    const suffix = el.dataset.suffix || '';
    const duration = 1500;
    
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.unobserve(el);

      const startTime = performance.now();
      const tick = (now) => {
        const progress = Math.min((now - startTime) / duration, 1);
        const ease = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.floor(ease * target) + suffix;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.5 });

    observer.observe(el);
  });
</script>
