---
// 4 marcadores "+" para encaixar nos cantos de uma seção (ou container)
// Pai precisa ter `position: relative`. Variantes:
//   - default: alinhados às bordas da seção (full-width)
//   - container: alinhados ao container-kore (recuo de 24/48/80px)
interface Props {
  align?: 'section' | 'container';
}
const { align = 'section' } = Astro.props;
const offsetClass = align === 'container' ? 'corners-container' : 'corners-section';
---

<span class={`cross-marker corner-tl ${offsetClass}`} aria-hidden="true"></span>
<span class={`cross-marker corner-tr ${offsetClass}`} aria-hidden="true"></span>
<span class={`cross-marker corner-bl ${offsetClass}`} aria-hidden="true"></span>
<span class={`cross-marker corner-br ${offsetClass}`} aria-hidden="true"></span>

<style>
  .cross-marker.corners-container {
    /* Alinhar com container-kore: padding 24/48/80px */
  }
  .cross-marker.corners-container.corner-tl { top: -5.5px; left: 24px; }
  .cross-marker.corners-container.corner-tr { top: -5.5px; right: 24px; }
  .cross-marker.corners-container.corner-bl { bottom: -5.5px; left: 24px; }
  .cross-marker.corners-container.corner-br { bottom: -5.5px; right: 24px; }
  @media (min-width: 768px) {
    .cross-marker.corners-container.corner-tl { left: 48px; }
    .cross-marker.corners-container.corner-tr { right: 48px; }
    .cross-marker.corners-container.corner-bl { left: 48px; }
    .cross-marker.corners-container.corner-br { right: 48px; }
  }
  @media (min-width: 1024px) {
    .cross-marker.corners-container.corner-tl { left: 80px; }
    .cross-marker.corners-container.corner-tr { right: 80px; }
    .cross-marker.corners-container.corner-bl { left: 80px; }
    .cross-marker.corners-container.corner-br { right: 80px; }
  }
  @media (min-width: 1360px) {
    /* Quando o container-kore (max-w 1200) começa a centralizar */
    .cross-marker.corners-container.corner-tl { left: max(80px, calc((100vw - 1200px) / 2)); }
    .cross-marker.corners-container.corner-tr { right: max(80px, calc((100vw - 1200px) / 2)); }
    .cross-marker.corners-container.corner-bl { left: max(80px, calc((100vw - 1200px) / 2)); }
    .cross-marker.corners-container.corner-br { right: max(80px, calc((100vw - 1200px) / 2)); }
  }
</style>
