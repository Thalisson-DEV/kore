---
const NAV_LINKS = [
  { href: '#lab', label: 'Lab', section: 'lab' },
  { href: '#workspace', label: 'Workspace', section: 'workspace' },
  { href: '#precos', label: 'Preços', section: 'precos' },
  { href: '#roadmap', label: 'Roadmap', section: 'roadmap' },
];
---

<nav id="main-nav" class="fixed top-0 left-0 w-full z-50 transition-all duration-300">
  <div class="nav-bg absolute inset-0 pointer-events-none transition-all duration-300"></div>

  <div class="container-kore relative z-10 nav-shell flex items-center justify-between transition-all duration-300">

    <!-- LEFT: Logo -->
    <a href="/" class="group flex items-center" aria-label="Voltar ao topo">
      <span class="text-xl font-mono font-bold tracking-tighter text-text group-hover:text-accent transition-colors">
        KORE<span class="text-accent cursor-blink">_</span>
      </span>
    </a>

    <!-- CENTER: Links com active indicator -->
    <div id="nav-links" class="hidden lg:flex items-center gap-1 absolute left-1/2 -translate-x-1/2">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          data-section={link.section}
          class="nav-link relative px-3 py-2 text-[11px] font-mono uppercase tracking-widest text-muted hover:text-text transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- RIGHT: Theme toggle + CTA + Mobile button -->
    <div class="flex items-center gap-2 sm:gap-3">

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="relative w-9 h-9 flex items-center justify-center text-muted hover:text-accent transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent rounded-md"
        aria-label="Alternar tema"
      >
        <svg id="sun-icon" class="w-4 h-4 absolute transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" stroke-width="1.5"/>
          <path stroke-linecap="round" stroke-width="1.5" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg id="moon-icon" class="w-4 h-4 absolute transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- Divider -->
      <span class="hidden sm:block w-px h-5 bg-border-subtle"></span>

      <!-- CTA -->
      <a
        href="#acesso"
        class="nav-cta group relative inline-flex items-center gap-2 px-4 py-2 sm:px-5 sm:py-2.5 text-bg text-[10px] sm:text-[11px] font-bold uppercase tracking-widest whitespace-nowrap"
      >
        <span class="relative z-10 flex items-center gap-1.5">
          Pegar acesso
          <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-toggle"
        class="lg:hidden w-9 h-9 flex flex-col items-center justify-center gap-1.5 text-text focus:outline-none rounded-md hover:bg-surface/40 transition-colors"
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        <span class="hamburger-line w-4 h-px bg-current transition-all duration-300"></span>
        <span class="hamburger-line w-4 h-px bg-current transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <!-- Border (aparece ao scrollar) -->
  <div class="nav-border absolute left-0 right-0 bottom-0 h-px bg-border-subtle opacity-0 transition-opacity duration-300"></div>
</nav>

<!-- Mobile drawer -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 lg:hidden pointer-events-none opacity-0 transition-opacity duration-400"
  aria-hidden="true"
>
  <div class="mobile-backdrop absolute inset-0 bg-bg/95 backdrop-blur-xl"></div>

  <div class="relative h-full flex flex-col justify-center container-kore pt-24 pb-12">
    <!-- Status -->
    <div class="mb-12 mobile-stagger">
      <p class="divider-label">
        <span class="w-8 h-px bg-faint"></span>
        <span>menu</span>
      </p>
    </div>

    <!-- Links -->
    <ul class="flex flex-col gap-1 mb-12">
      {NAV_LINKS.map((link, i) => (
        <li class="mobile-stagger" style={`--stagger-i: ${i}`}>
          <a
            href={link.href}
            class="mobile-link group flex items-baseline gap-4 py-3 border-b border-border-subtle"
          >
            <span class="text-[11px] font-mono text-faint w-8 tabular-nums">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-3xl font-bold text-text group-hover:text-accent transition-colors">
              {link.label}
            </span>
            <svg class="ml-auto w-4 h-4 text-faint group-hover:text-accent group-hover:translate-x-1 transition-all" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA mobile -->
    <div class="mobile-stagger" style="--stagger-i: 5">
      <a
        href="#acesso"
        class="nav-cta inline-flex items-center justify-center gap-2 w-full px-6 py-4 text-bg text-[12px] font-bold uppercase tracking-widest"
      >
        Pegar meu acesso
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <p class="text-center text-[10px] font-mono text-faint uppercase tracking-widest mt-4">
        3 otimizações/mês grátis
      </p>
    </div>
  </div>
</div>

<style>
  /* ─── NAV CHROME ─────────────────────────────────── */
  .nav-shell {
    height: 80px;
  }

  #main-nav.is-scrolled .nav-shell {
    height: 60px;
  }

  .nav-bg {
    background: transparent;
  }

  #main-nav.is-scrolled .nav-bg {
    background: rgba(9, 9, 11, 0.7);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
  }

  :root[data-theme="light"] #main-nav.is-scrolled .nav-bg {
    background: rgba(255, 255, 255, 0.75);
  }

  #main-nav.is-scrolled .nav-border {
    opacity: 1;
  }

  /* ─── LOGO BLINK ─────────────────────────────────── */
  .cursor-blink {
    animation: blink 1.2s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0; }
  }

  /* ─── ACTIVE LINK INDICATOR ──────────────────────── */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateX(-50%);
    opacity: 0;
  }
  .nav-link.is-active {
    color: var(--color-text);
  }
  .nav-link.is-active::after {
    width: 60%;
    opacity: 1;
  }

  /* ─── CTA NAV ────────────────────────────────────── */
  .nav-cta {
    background: var(--color-accent);
    color: var(--color-bg);
    border-radius: 4px;
    box-shadow:
      0 0 0 1px rgba(59, 130, 246, 0.35),
      0 6px 20px -6px rgba(59, 130, 246, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
    overflow: hidden;
    isolation: isolate;
    position: relative;
  }
  .nav-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.3) 50%, transparent 65%);
    transform: translateX(-100%);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-cta:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgba(59, 130, 246, 0.55),
      0 10px 24px -8px rgba(59, 130, 246, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }
  .nav-cta:hover::before {
    transform: translateX(100%);
  }

  /* ─── THEME TOGGLE ICONS ─────────────────────────── */
  #theme-toggle #sun-icon,
  #theme-toggle #moon-icon {
    opacity: 0;
    transform: scale(0.6) rotate(-90deg);
  }
  :root:not([data-theme="light"]) #theme-toggle #sun-icon {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
  :root[data-theme="light"] #theme-toggle #moon-icon {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  /* ─── HAMBURGER ──────────────────────────────────── */
  #mobile-toggle.is-open .hamburger-line:nth-child(1) {
    transform: translateY(3px) rotate(45deg);
  }
  #mobile-toggle.is-open .hamburger-line:nth-child(2) {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* ─── MOBILE DRAWER ──────────────────────────────── */
  #mobile-menu.is-open {
    pointer-events: auto;
    opacity: 1;
  }
  #mobile-menu.is-open .mobile-stagger {
    animation: mobile-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) calc(0.08s * var(--stagger-i, 0) + 0.15s) both;
  }
  .mobile-stagger { opacity: 0; }

  @keyframes mobile-rise {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Trava scroll quando menu aberto */
  body.menu-open {
    overflow: hidden;
  }
</style>

<script is:inline>
  // ─── Scroll state (compact + blur) ─────────────────────────
  const nav = document.getElementById('main-nav');

  const updateNav = () => {
    if (window.scrollY > 16) nav.classList.add('is-scrolled');
    else nav.classList.remove('is-scrolled');
  };
  updateNav();
  window.addEventListener('scroll', updateNav, { passive: true });

  // ─── Active link via IntersectionObserver ─────────────────
  const sections = document.querySelectorAll('section[id]');
  const links = document.querySelectorAll('.nav-link');

  const setActive = (id) => {
    links.forEach((l) => {
      if (l.dataset.section === id) l.classList.add('is-active');
      else l.classList.remove('is-active');
    });
  };

  if ('IntersectionObserver' in window) {
    const sectionObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      {
        rootMargin: '-30% 0px -60% 0px',
        threshold: 0,
      }
    );
    sections.forEach((s) => sectionObs.observe(s));
  }

  // ─── Mobile menu drawer ────────────────────────────────────
  const mobileBtn = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  const toggleMobile = (open) => {
    const willOpen = open !== undefined ? open : !mobileMenu.classList.contains('is-open');
    mobileMenu.classList.toggle('is-open', willOpen);
    mobileBtn.classList.toggle('is-open', willOpen);
    mobileBtn.setAttribute('aria-expanded', willOpen.toString());
    mobileMenu.setAttribute('aria-hidden', (!willOpen).toString());
    document.body.classList.toggle('menu-open', willOpen);
  };

  mobileBtn.addEventListener('click', () => toggleMobile());

  // Close on link click
  document.querySelectorAll('.mobile-link').forEach((l) => {
    l.addEventListener('click', () => toggleMobile(false));
  });

  // Close on ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu.classList.contains('is-open')) toggleMobile(false);
  });

  // ─── Theme toggle (sem flash de ícones) ────────────────────
  const themeToggle = document.getElementById('theme-toggle');
  const getTheme = () => document.documentElement.getAttribute('data-theme') || 'dark';

  themeToggle.addEventListener('click', () => {
    const newTheme = getTheme() === 'dark' ? 'light' : 'dark';
    if (newTheme === 'light') document.documentElement.setAttribute('data-theme', 'light');
    else document.documentElement.removeAttribute('data-theme');
    localStorage.setItem('theme', newTheme);
  });
</script>
