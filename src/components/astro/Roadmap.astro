---
---

<section id="roadmap" class="section-gap hatch-bg border-y border-border-subtle reveal">
  <div class="container-kore">
    <!-- Separador -->
    <div class="divider-label mb-24">
      <span class="w-12 h-[1px] bg-border"></span>
      ROADMAP
      <span class="flex-grow h-[1px] bg-border"></span>
    </div>

    <h2 class="text-section mb-24">Evolução contínua<span class="text-accent">.</span></h2>

    <div class="relative flex flex-col md:flex-row gap-16 md:gap-0">
      <!-- Linha Conectora (Desktop) -->
      <div class="absolute top-10 left-0 w-full h-[1px] bg-border hidden md:block"></div>

      <!-- Etapa 1 -->
      <div class="flex-1 relative z-10 md:pr-12">
        <div class="w-20 h-20 bg-bg border border-accent flex items-center justify-center mb-10 rounded-sm shadow-[0_0_20px_rgba(59,130,246,0.1)]">
          <span class="text-mono text-accent font-bold text-xl">01</span>
        </div>
        <p class="text-[10px] font-mono text-accent uppercase tracking-[0.2em] mb-4">Q2 2026</p>
        <h4 class="text-body font-bold mb-4 uppercase tracking-tight">Fundação Estratégica</h4>
        <p class="text-caption text-muted leading-relaxed">Lançamento do motor ATS core e simulador de injeção semântica em beta fechada.</p>
      </div>

      <!-- Etapa 2 -->
      <div class="flex-1 relative z-10 md:px-8">
        <div class="w-16 h-16 bg-bg border border-border flex items-center justify-center mb-8 rounded-sm">
          <span class="text-mono text-muted font-bold">02</span>
        </div>
        <p class="text-[10px] font-mono text-muted uppercase tracking-widest mb-2">Q3 2026</p>
        <h4 class="text-body font-bold mb-4">Expansão de Recursos</h4>
        <p class="text-caption text-muted">Integração completa BYOK, gerenciamento de múltiplas personas e CRM de vagas.</p>
      </div>

      <!-- Etapa 3 -->
      <div class="flex-1 relative z-10 md:px-8">
        <div class="w-16 h-16 bg-bg border border-border flex items-center justify-center mb-8 rounded-sm">
          <span class="text-mono text-muted font-bold">03</span>
        </div>
        <p class="text-[10px] font-mono text-muted uppercase tracking-widest mb-2">2027</p>
        <h4 class="text-body font-bold mb-4 text-muted">Sincronização de Rede</h4>
        <p class="text-caption text-muted">Agentes autônomos de candidatura e análise preditiva de mercado em tempo real.</p>
      </div>

      <!-- Marco -->
      <div class="flex-1 relative z-10 md:pl-8">
        <div class="w-16 h-16 bg-surface border border-border-subtle flex items-center justify-center mb-8 rounded-sm">
          <span class="text-accent">★</span>
        </div>
        <p class="text-[10px] font-mono text-muted uppercase tracking-widest mb-2">Goal</p>
        <h4 class="text-body font-bold mb-4 text-muted">Referência no Setor</h4>
        <p class="text-caption text-muted">Tornar-se a infraestrutura padrão para soberania de carreira técnica global.</p>
      </div>
    </div>
  </div>
</section>
