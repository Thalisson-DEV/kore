---
---

<section id="roadmap" class="relative py-32 lg:py-48 hatch-bg reveal">
  <div class="container-kore">
    <!-- Header -->
    <div class="mb-24 lg:mb-32 max-w-2xl">
      <p class="text-mono text-accent mb-6">ROADMAP</p>
      <h2 class="text-section">
        Evolução<br/>contínua<span class="text-accent">.</span>
      </h2>
    </div>

    <!-- Timeline -->
    <div class="relative flex flex-col md:flex-row gap-16 md:gap-0">
      <!-- Linha conectora desktop (tracejada) -->
      <div class="absolute top-8 left-0 w-full border-t border-dashed border-border hidden md:block"></div>

      <!-- Etapa 1 — Ativa (mantém solid, hierarquia) -->
      <div class="flex-1 relative z-10 md:pr-12">
        <div class="w-16 h-16 bg-bg border border-accent flex items-center justify-center mb-10 shadow-[0_0_24px_rgba(59,130,246,0.15)]">
          <span class="text-[11px] font-mono text-accent font-bold">01</span>
        </div>
        <p class="text-mono text-accent mb-4">Q2 2026</p>
        <h4 class="text-base font-bold mb-3 uppercase tracking-tight">Fundação Estratégica</h4>
        <p class="text-sm text-faint leading-relaxed">Lançamento do motor ATS core e simulador em beta fechada.</p>
      </div>

      <!-- Etapa 2 -->
      <div class="flex-1 relative z-10 md:px-8">
        <div class="w-12 h-12 bg-bg border border-dashed border-border flex items-center justify-center mb-10">
          <span class="text-[11px] font-mono text-faint font-bold">02</span>
        </div>
        <p class="text-mono text-faint mb-4">Q3 2026</p>
        <h4 class="text-base font-bold mb-3">Expansão de Recursos</h4>
        <p class="text-sm text-faint leading-relaxed">Múltiplas personas, CRM de vagas e integrações.</p>
      </div>

      <!-- Etapa 3 -->
      <div class="flex-1 relative z-10 md:px-8">
        <div class="w-12 h-12 bg-bg border border-dashed border-border flex items-center justify-center mb-10">
          <span class="text-[11px] font-mono text-faint font-bold">03</span>
        </div>
        <p class="text-mono text-faint mb-4">2027</p>
        <h4 class="text-base font-bold mb-3 text-muted">Agente Autônomo</h4>
        <p class="text-sm text-faint leading-relaxed">Candidatura automática e análise preditiva de mercado.</p>
      </div>

      <!-- Marco final -->
      <div class="flex-1 relative z-10 md:pl-8">
        <div class="w-12 h-12 bg-surface border border-dashed border-border flex items-center justify-center mb-10">
          <span class="text-accent text-sm">★</span>
        </div>
        <p class="text-mono text-faint mb-4">Goal</p>
        <h4 class="text-base font-bold mb-3 text-muted">Referência no Setor</h4>
        <p class="text-sm text-faint leading-relaxed">Infraestrutura padrão para carreira técnica global.</p>
      </div>
    </div>
  </div>
</section>
