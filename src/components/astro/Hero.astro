---
import HeroVisual from '../react/HeroVisual';
---

<section class="relative min-h-[100svh] flex items-center overflow-hidden pt-24 lg:pt-28 pb-20 lg:pb-32">

  <!-- Glow radial: inferior-direito → centro (azul accent) -->
  <div class="hero-radial-glow"></div>

  <!-- Grid pattern sutil -->
  <div
    class="absolute inset-0 pointer-events-none -z-10 opacity-[0.4]"
    style="background-image: linear-gradient(rgba(228,228,240,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(228,228,240,0.025) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black 30%, transparent 80%);"
  ></div>

  <div class="container-kore w-full relative z-10">
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-14 lg:gap-20 items-center">

      <!-- Coluna esquerda: copy + CTA -->
      <div class="flex flex-col items-start text-left">

        <!-- Live social proof badge -->
        <div class="hero-eyebrow inline-flex items-center gap-2 px-3 py-1.5 mb-8 bg-surface/60 border border-dashed border-border rounded-full backdrop-blur-sm">
          <span class="relative flex w-1.5 h-1.5">
            <span class="absolute inline-flex w-full h-full rounded-full bg-success opacity-75 animate-ping"></span>
            <span class="relative inline-flex w-1.5 h-1.5 rounded-full bg-success"></span>
          </span>
          <span class="text-[10px] font-mono text-muted uppercase tracking-widest">
            <span class="text-text font-bold">0</span> devs otimizaram esta semana
          </span>
        </div>

        <!-- Headline 2-linhas (estilo AbacatePay) -->
        <h1 class="hero-title text-[clamp(40px,7vw,76px)] font-bold tracking-tighter leading-[1.02] mb-6 text-balance">
          <span class="block">Vença o ATS.</span>
          <span class="block">Antes do RH <span class="pain-underline">abrir</span>.</span>
        </h1>

        <!-- Sub -->
        <p class="hero-sub text-lg text-muted mb-10 leading-relaxed max-w-[460px]">
          Motor de otimização ATS com injeção semântica de keywords.
          <span class="text-text font-medium">Seu currículo passa</span> antes de qualquer humano ler.
        </p>

        <!-- CTAs -->
        <div class="hero-ctas flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-10 w-full sm:w-auto">
          <a
            href="#acesso"
            class="cta-primary group relative inline-flex items-center justify-center px-7 py-4 text-bg text-[12px] font-bold uppercase tracking-wider whitespace-nowrap"
          >
            <span class="relative z-10 flex items-center gap-2">
              Otimizar grátis
              <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
          <a
            href="#lab"
            class="cta-link group inline-flex items-center justify-center gap-2 px-4 py-4 text-muted hover:text-text text-[12px] font-medium uppercase tracking-wider transition-colors whitespace-nowrap"
          >
            Por que usar?
            <svg class="w-3 h-3 opacity-50 group-hover:opacity-100 transition-opacity" viewBox="0 0 16 16" fill="none">
              <path d="M6 12l4-4-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <!-- 2 feature badges (estilo foto: ícone + título + descrição) -->
        <div class="hero-badges grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-10 pt-8 border-t border-dashed border-border w-full max-w-[460px]">
          <div class="flex items-start gap-3">
            <div class="flex items-center justify-center w-9 h-9 border border-dashed border-border rounded-md text-accent shrink-0 mt-0.5">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z"/>
              </svg>
            </div>
            <div>
              <div class="text-[13px] font-semibold text-text mb-0.5">Rápido</div>
              <div class="text-[12px] text-muted leading-relaxed">Score em 8 minutos.</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="flex items-center justify-center w-9 h-9 border border-dashed border-border rounded-md text-accent shrink-0 mt-0.5">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <div class="text-[13px] font-semibold text-text mb-0.5">Seguro</div>
              <div class="text-[12px] text-muted leading-relaxed">De ponta a ponta.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Coluna direita: visual interativo (placeholder até mockup chegar) -->
      <div class="hero-visual w-full">
        <HeroVisual client:visible />
      </div>

    </div>
  </div>
</section>

<style>
  .hero-eyebrow { animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
  .hero-title   { animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }
  .hero-sub     { animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both; }
  .hero-ctas    { animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both; }
  .hero-badges  { animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Magnetic CTA primary */
  .cta-primary {
    background: var(--color-accent);
    color: var(--color-bg);
    border-radius: 4px;
    box-shadow:
      0 0 0 1px rgba(59, 130, 246, 0.3),
      0 8px 24px -8px rgba(59, 130, 246, 0.5),
      0 0 60px -10px rgba(59, 130, 246, 0.4);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
    overflow: hidden;
    isolation: isolate;
  }
  .cta-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,0.35) 50%, transparent 65%);
    transform: translateX(-100%);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px rgba(59, 130, 246, 0.5),
      0 16px 36px -10px rgba(59, 130, 246, 0.6),
      0 0 80px -10px rgba(59, 130, 246, 0.55);
  }
  .cta-primary:hover::before {
    transform: translateX(100%);
  }
  .cta-primary:active {
    transform: translateY(0);
  }

  /* Hero corners alinhados ao container-kore (24/48/80px) */
  .hero-corner-tl,
  .hero-corner-tr,
  .hero-corner-bl,
  .hero-corner-br { z-index: 5; }
  .hero-corner-tl { top: 88px; left: 24px; }
  .hero-corner-tr { top: 88px; right: 24px; }
  .hero-corner-bl { bottom: 24px; left: 24px; }
  .hero-corner-br { bottom: 24px; right: 24px; }
  @media (min-width: 768px) {
    .hero-corner-tl { left: 48px; }
    .hero-corner-tr { right: 48px; }
    .hero-corner-bl { left: 48px; }
    .hero-corner-br { right: 48px; }
  }
  @media (min-width: 1024px) {
    .hero-corner-tl { left: 80px; }
    .hero-corner-tr { right: 80px; }
    .hero-corner-bl { left: 80px; }
    .hero-corner-br { right: 80px; }
  }
  @media (min-width: 1360px) {
    .hero-corner-tl { left: max(80px, calc((100vw - 1200px) / 2)); }
    .hero-corner-tr { right: max(80px, calc((100vw - 1200px) / 2)); }
    .hero-corner-bl { left: max(80px, calc((100vw - 1200px) / 2)); }
    .hero-corner-br { right: max(80px, calc((100vw - 1200px) / 2)); }
  }

  .cta-link {
    position: relative;
  }
  .cta-link::after {
    content: '';
    position: absolute;
    left: 16px;
    right: 32px;
    bottom: 12px;
    height: 1px;
    background: var(--color-faint);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cta-link:hover::after {
    transform: scaleX(1);
    background: var(--color-text);
  }
</style>
