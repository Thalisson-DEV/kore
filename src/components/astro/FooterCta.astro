---
import FooterCtaVisual, { FooterStats } from '../react/FooterCtaVisual';
---

<section id="acesso" class="relative py-32 lg:py-52 overflow-hidden bg-bg">

  <!-- Dot grid with radial fade -->
  <div
    class="absolute inset-0 pointer-events-none -z-10"
    style="
      background-image: radial-gradient(circle, rgba(59,130,246,0.18) 1px, transparent 1px);
      background-size: 28px 28px;
      mask-image: radial-gradient(ellipse 80% 85% at 50% 50%, black 0%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 80% 85% at 50% 50%, black 0%, transparent 75%);
    "
  ></div>

  <!-- Central atmospheric glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[560px] h-[280px] bg-accent opacity-[0.09] blur-[100px] rounded-full pointer-events-none -z-10"></div>

  <!-- Top accent line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>

  <div class="container-kore relative z-10 flex flex-col items-center text-center">

    <!-- Live counter + progress bar (React island) -->
    <FooterCtaVisual client:visible />

    <!-- Headline — 3 atos: fato, problema, solução -->
    <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tighter leading-[1.05] max-w-3xl mb-6">
      <span class="text-text">Seu currículo existe.</span><br/>
      <span class="text-muted">O ATS não te vê.</span><br/>
      <span class="text-accent">A Kore muda isso.</span>
    </h2>

    <!-- Subline -->
    <p class="text-muted text-lg max-w-sm mb-10 leading-relaxed">
      Motor ATS + otimização semântica + exportação PDF.<br/>
      <span class="text-text font-medium">Resultados em 8 minutos. Sem adivinhação.</span>
    </p>

    <!-- CTA -->
    <div class="relative mb-5">
      <div class="cta-orbit-ring"></div>
      <a
        href="#acesso"
        class="cta-mega group relative inline-flex items-center justify-center gap-3 px-12 py-5 text-bg text-[13px] font-bold uppercase tracking-wider"
      >
        <span class="relative z-10 flex items-center gap-3">
          Garantir minha vaga
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>

    <!-- Trust signals — direto abaixo do CTA para reduzir fricção -->
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mb-16 text-[10px] font-mono text-faint uppercase tracking-widest">
      <span>✓ Sem cartão de crédito</span>
      <span class="hidden sm:block w-px h-3 bg-border-subtle"></span>
      <span>✓ Cancele quando quiser</span>
      <span class="hidden sm:block w-px h-3 bg-border-subtle"></span>
      <span>✓ AES-256</span>
    </div>

    <!-- Stats + Testimonial (React island) -->
    <!-- <FooterStats client:visible /> -->

  </div>
</section>

<style>
  .cta-mega {
    background: var(--color-accent);
    color: var(--color-bg);
    border-radius: 4px;
    box-shadow:
      0 0 0 1px rgba(59, 130, 246, 0.4),
      0 12px 32px -8px rgba(59, 130, 246, 0.5);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cta-mega:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px rgba(59, 130, 246, 0.6),
      0 20px 48px -10px rgba(59, 130, 246, 0.65);
  }

  .cta-orbit-ring {
    position: absolute;
    top: 50%; left: 50%;
    width: 100%; height: 100%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .cta-orbit-ring::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 4px;
    border: 1px solid rgba(59, 130, 246, 0.2);
    animation: orbit-pulse 2s ease-out infinite;
  }

  @keyframes orbit-pulse {
    0%   { inset: -4px;  opacity: 0.8; }
    100% { inset: -20px; opacity: 0; }
  }
</style>
