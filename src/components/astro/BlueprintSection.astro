---
import BlueprintCorners from './BlueprintCorners.astro';

interface Props {
  class?: string;
  id?: string;
  align?: 'section' | 'container';
  dotGrid?: boolean;
}
const { class: className = '', id, align = 'container', dotGrid = false } = Astro.props;
---

<section
  class={`relative ${dotGrid ? 'bg-dot-grid' : ''} ${className}`}
  {...(id ? { id } : {})}
>
  <BlueprintCorners align={align} />
  <slot />
</section>
